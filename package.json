{
  "name": "jangsang",
  "version": "1.0.1",
  "description": "A two-layer CSS framework: one file for layout, one file for your visual skin. Swap skins by changing a single data-attribute.",
  "keywords": [
    "css",
    "framework",
    "design-system",
    "theming",
    "skins",
    "glassmorphism",
    "neumorphism",
    "material",
    "glow",
    "flat"
  ],
  "author": "Garnilo",
  "license": "MIT",
  "homepage": "https://github.com/garniloy/jangsang#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garniloy/jangsang.git"
  },
  "bugs": {
    "url": "https://github.com/garniloy/jangsang/issues"
  },
  "style": "./src/layout.css",
  "files": [
    "src/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "exports": {
    ".":               "./src/layout.css",
    "./layout":        "./src/layout.css",
    "./skin/flat":     "./src/skins/flat.css",
    "./skin/material": "./src/skins/material.css",
    "./skin/glow":     "./src/skins/glow.css",
    "./skin/glass":    "./src/skins/glass.css",
    "./skin/neuro":    "./src/skins/neuro.css",
    "./skin/all":      "./src/skins/all.css"
  }
}
